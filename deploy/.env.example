# ReportHub 后端环境变量配置示例
# 复制此文件为 .env 并填入实际值

# JWT 密钥（必须设置，使用随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 密码加密密钥（必须设置，用于加密数据库密码）
PASSWORD_ENCRYPT_KEY=your-aes-encryption-key-change-this

# 服务器配置
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# 数据库配置
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/reporthub?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=reporthub
SPRING_DATASOURCE_PASSWORD=ReportHub@2026

# Redis 配置
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# CORS 配置（多个域名用逗号分隔）
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# MyBatis 日志（生产环境建议留空关闭）
MYBATIS_LOG_IMPL=
